# MySQL 8 connection string
DATABASE_URL="mysql://root:password@localhost:3306/minieh_rides"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
# Comma separated list of allowed web origins for the admin panel ("*" in dev)
CORS_ORIGINS="*"
# Routing for distance/time: haversine (offline, default) | osrm | google
ROUTING_PROVIDER=haversine
OSRM_URL="https://router.project-osrm.org"
GOOGLE_MAPS_API_KEY=""
# First admin account created by `npm run seed`
ADMIN_PHONE="+96170000000"
ADMIN_PASSWORD="admin123"
