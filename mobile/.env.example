# Backend origin (no trailing slash, no /api). API base = ${EXPO_PUBLIC_API_URL}/api
# Android emulator -> host machine: http://10.0.2.2:4000
# Physical device on the same Wi-Fi: http://<your-PC-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Google Maps SDK key for Android dev/release builds (not needed in Expo Go)
GOOGLE_MAPS_API_KEY=

# Optional: EAS project id (needed for Expo push tokens in dev/production builds)
EAS_PROJECT_ID=
